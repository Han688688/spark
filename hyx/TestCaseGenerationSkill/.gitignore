# TestCaseGenerationSkill .gitignore

# 输出目录（运行后生成）
output/
*.json
*.yaml.out

# Python缓存
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# 测试缓存
.pytest_cache/
.coverage
htmlcov/

# IDE
.vscode/
.idea/
*.swp
*.swo

# 临时文件
*.tmp
*.bak
*~

# 操作系统
.DS_Store
Thumbs.db

# 日志
*.log

# 构建产物
build/
dist/
*.egg-info/
.eggs/

# 虚拟环境
venv/
.venv/
env/